{
  "name": "shelf",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx scripts/server.ts --dev",
    "build": "prisma generate && next build && tsc -p tsconfig.reset.json && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node .server-build/scripts/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "admin:reset-password": "node scripts/reset-password.js",
    "api:openapi": "node --import tsx scripts/generate-openapi.ts",
    "api:openapi:check": "node --import tsx scripts/generate-openapi.ts --check",
    "screenshot": "playwright test --project screenshot"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/api-key": "^1.7.12",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/zod-openapi": "^1.6.3",
    "@libsql/client": "^0.18.0",
    "@prisma/adapter-libsql": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tanstack/react-query": "^5.104.5",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "better-auth": "^1.7.5",
    "hono": "^4.13.13",
    "nanoid": "^6.0.2",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "latest",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true
  }
}
